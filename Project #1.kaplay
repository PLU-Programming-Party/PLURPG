{"name":"Project #1","version":"2.0.0","files":[["main.js",{"path":"main.js","kind":"main","value":"import \"./kaplay.js\";\nimport \"./assets.js\";\nimport \"./scenes/game.js\"\n\ngo(\"game\");\n\n\n","language":"javascript"}],["assets.js",{"path":"assets.js","kind":"assets","value":"loadSprite(\"mark\", \"assets/sprites/mark.png\");\nloadSprite(\"Skimage\", \"assets/sprites/Skimage.png\");\nloadHappy();\n","language":"javascript"}],["kaplay.js",{"path":"kaplay.js","kind":"kaplay","value":"kaplay({\n    focus: false,\n    font: \"happy\",\n    background: \"#4a3052\", \n});\n","language":"javascript"}],["scenes/game.js",{"path":"scenes/game.js","kind":"scene","value":"import { addWelcomeText } from \"../objects/welcomeText.js\";\n\nscene(\"game\", () => {\n    addWelcomeText();\n    const berk = add([\n        sprite(\"Skimage\"),\n        pos(0,0),\n        scale(.7),\n        anchor(\"topleft\"),\n        rotate(0),\n    ]);\n    // move left by SPEED pixels per frame every frame when left arrow key is being held down\nonKeyDown(\"left\", () => {\n    berk.move(-100, 0)\n});\nonKeyDown(\"right\", () => {\n    berk.move(100, 0)\n});\nonKeyDown(\"up\", () => {\n    berk.move(0, -100)\n});\nonKeyDown(\"down\", () => {\n    berk.move(0, 100)\n});\n});","language":"javascript"}],["objects/welcomeText.js",{"path":"objects/welcomeText.js","kind":"obj","value":"export function addWelcomeText() {\n    const txt = add([\n        text(\"Welcome to\\n KAPLAYGROUND\\n 2.5.4\", { align: \"center\" }),\n        pos(center().add(0, -130)),\n        anchor(\"center\"),\n    ]);\n\n    return txt;\n}\n","language":"javascript"}]],"assets":[["assets/sprites/mark.png",{"name":"mark.png","path":"assets/sprites/mark.png","url":"data:image/png;base64,","kind":"sprite","importFunction":"loadSprite(\"mark\", \"assets/sprites/mark.png\");"}],["assets/sounds/mark_voice.wav",{"name":"mark_voice.wav","path":"assets/sounds/mark_voice.wav","url":"data:audio/wave;base64,","kind":"sound","importFunction":"loadSound(\"mark_voice\", \"assets/sounds/mark_voice.wav\");"}],["assets/sprites/Skimage.png",{"name":"Skimage.png","kind":"sprite","path":"assets/sprites/Skimage.png","url":"data:image/png;base64,","importFunction":"loadSprite(\"Skimage\", \"assets/sprites/Skimage.png\");"}]],"mode":"pj","buildMode":"esbuild","kaplayVersion":"4000.0.0-alpha.27.1","createdAt":"2026-11-19T05:32:42.082Z","updatedAt":"2026-11-19T05:53:31.154Z","favicon":"","id":"01a1f24a-f8e2-7ee6-acce-ff0ad47024c8"}